// A detached pill rather than a notch: the island floats below the top edge
// with all four corners rounded. Setting topInset above 0 turns the concave
// shoulders off automatically, since there is no screen edge left to blend in
// to. Motion is softened to match the lighter look.
{
  "island": {
    "shape": {
      "topInset": 8,
      "radiusTop": 16,
      "radiusBottom": 16,
      "fillet": 0
    },
    "motion": {
      "response": 0.5,
      "damping": 0.6
    },
    "style": {
      "opacity": 0.94,
      "borderWidth": 1
    }
  }
}
