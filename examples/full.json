// Everything switched on: the island carries the information a status bar
// would, reveals the rest on hover, and opens into a full control centre.
{
  "island": {
    "left": ["menu"],
    "right": ["network", "bluetooth", "volume", "controlCentre", "clock", "battery"],
    "collapsed": ["albumArt", "media", "window", "waveform"],
    "hover": ["albumArt", "media", "mediaControls", "volume", "battery"],
    "expanded": ["media", "sliders", "notifications"],
    "shape": {
      "collapsedWidth": 220,
      "collapsedHeight": 30
    },
    "modules": {
      "clock": { "format": "ddd h:mm AP" },
      "battery": { "warnBelow": 15 },
      "media": { "maxTitleWidth": 170 }
    },
    "activities": {
      "notification": { "maxBodyLines": 3 },
      "media": { "duration": 3000 }
    }
  }
}
